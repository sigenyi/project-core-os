# Settings for core-inference.service (llama.cpp llama-server).
# After editing: systemctl restart core-inference

# Context window in tokens. Keep [inference] context_tokens in agent.toml equal.
CORE_CTX_SIZE=8192

# Layers to offload to the GPU (needs a Vulkan build of llama.cpp). 0 = CPU only,
# 99 = everything that fits.
CORE_GPU_LAYERS=0

# Extra llama-server flags, e.g. "--threads 6 --mlock".
CORE_LLAMA_ARGS=
