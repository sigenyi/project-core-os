# C.O.R.E. OS package set (replaces archiso releng's list).
# Deliberately small: no X11, no Wayland, no desktop, no display manager.

# --- base system ----------------------------------------------------------------
base
linux
linux-firmware
sof-firmware
intel-ucode
amd-ucode
mkinitcpio
mkinitcpio-archiso

# --- boot (required by archiso boot modes) ----------------------------------------
syslinux
grub
efibootmgr
edk2-shell
memtest86+
memtest86+-efi

# --- tools the Guardian drives -------------------------------------------------
networkmanager
wireless-regdb
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
alsa-utils
pciutils
usbutils
iproute2
iputils
procps-ng
util-linux
kmod
btrfs-progs
dosfstools
e2fsprogs

# --- GPU offload for the language model (Vulkan) --------------------------------
vulkan-icd-loader
vulkan-radeon
vulkan-intel

# --- console --------------------------------------------------------------------
terminus-font
htop
nano
vim
less
man-db
w3m
